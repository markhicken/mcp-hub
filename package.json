{
  "name": "mcp-hub",
  "private": true,
  "version": "0.3.0",
  "description": "A persistent local hub that proxies every MCP server and manages their credentials in memory.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:core": "npm run dev -w @mcp-hub/core",
    "dev:ui": "npm run dev -w @mcp-hub/ui",
    "build": "npm run build -w @mcp-hub/core -w @mcp-hub/ui",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p scripts/screenshots",
    "screenshots": "npm run build -w @mcp-hub/ui && node scripts/screenshots/capture.ts",
    "version-up": "node scripts/version.mjs bump",
    "test": "npm test --workspaces --if-present",
    "test:windows": "node scripts/test-windows.mjs",
    "build:sidecars": "node scripts/build-sidecars.mjs",
    "build:app": "npm run build -w @mcp-hub/ui && npm run build:sidecars && node scripts/with-signing.mjs npm run build -w @mcp-hub/desktop && node scripts/collect-dist.mjs",
    "build:app:debug": "node scripts/build-app-debug.mjs",
    "setup:signing": "node scripts/setup-signing.mjs"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "playwright": "^1.64.1"
  }
}
