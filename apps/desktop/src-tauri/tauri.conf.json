{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MCP Hub",
  "version": "0.3.0",
  "identifier": "com.mcphub.app",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "A persistent local hub for every MCP server on your machine.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/mcp-hub-core",
      "binaries/mcp-hub-stdio"
    ],
    "resources": {
      "resources/ui/": "ui"
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    }
  }
}
